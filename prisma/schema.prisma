generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ReceiptStatus {
  PENDING
  PROCESSING
  PROCESSED
  REVIEW_REQUIRED
  ERROR
}

enum ProcessingStage {
  IDLE
  READING
  VALIDATING
  CATEGORIZING
  CALCULATING
  MAPPING
  REVIEW
  COMPLETE
  ERROR
}

enum DocumentationStatus {
  SUFFICIENT
  INSUFFICIENT
  MISSING
  REVIEW_REQUIRED
}

enum GstNumberStatus {
  VALID_FORMAT
  INVALID_FORMAT
  MISSING
  MALFORMED
  SUSPICIOUS
  UNKNOWN
}

enum ItcStatus {
  ELIGIBLE
  PARTIAL
  INELIGIBLE
  REVIEW
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  EDITED
}

enum AgentRunStatus {
  RUNNING
  COMPLETE
  ERROR
  REVIEW_REQUIRED
}

enum ToolCallStatus {
  RUNNING
  SUCCESS
  ERROR
}

enum AuditStatus {
  SUCCESS
  FAILURE
}

enum ExpenseType {
  OFFICE
  MEALS
  ENTERTAINMENT
  TRAVEL
  CASH
  OTHER
}

model Receipt {
  id                    String              @id @default(cuid())
  vendorName            String
  receiptDate           DateTime
  subtotal              Decimal             @db.Decimal(12, 2)
  taxAmount             Decimal             @db.Decimal(12, 2)
  totalAmount           Decimal             @db.Decimal(12, 2)
  taxType               String?
  gstHstNumber          String?
  commercialUsePercent  Decimal             @db.Decimal(5, 2)
  description           String?
  status                ReceiptStatus       @default(PENDING)
  processingStage       ProcessingStage     @default(IDLE)
  documentationStatus   DocumentationStatus @default(REVIEW_REQUIRED)
  gstNumberStatus       GstNumberStatus     @default(UNKNOWN)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  expense               Expense?
  agentRuns             AgentRun[]
  toolCalls             ToolCall[]
  approvals             Approval[]
  auditEvents           AuditEvent[]

  @@index([receiptDate])
  @@index([status])
}

model Expense {
  id                    String        @id @default(cuid())
  receiptId             String        @unique
  category              String?
  expenseType           ExpenseType?
  gifiCode              String?
  gifiDescription       String?
  classificationReason  String?
  classificationConfidence Decimal?   @db.Decimal(5, 4)

  grossTax              Decimal       @db.Decimal(12, 2)
  eligibilityPercentage Decimal       @db.Decimal(5, 2)
  eligibleItc           Decimal       @db.Decimal(12, 2)
  itcStatus             ItcStatus
  itcReasonCode         String?

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  receipt               Receipt       @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([gifiCode])
  @@index([itcStatus])
}

model GifiCode {
  id                    String   @id @default(cuid())
  code                  String   @unique
  description           String
  category              String
  parent                String?
  applicableExpenseTypes String?
  confidence            Decimal? @db.Decimal(5, 4)
  source                String?
  active                Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([category])
}

model ComplianceRule {
  id          String   @id @default(cuid())
  ruleCode    String   @unique
  name        String
  description String
  ruleVersion String
  source      String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AgentRun {
  id             String          @id @default(cuid())
  receiptId      String?
  requestId      String?
  model          String?
  status         AgentRunStatus  @default(RUNNING)
  currentStage   ProcessingStage @default(IDLE)
  startedAt      DateTime        @default(now())
  completedAt    DateTime?
  errorMessage   String?

  receipt        Receipt?        @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  toolCalls      ToolCall[]
  auditEvents    AuditEvent[]

  @@index([receiptId])
  @@index([requestId])
  @@index([status])
}

model ToolCall {
  id            String         @id @default(cuid())
  agentRunId    String?
  receiptId     String?
  toolName      String
  inputJson     Json
  outputJson    Json?
  status        ToolCallStatus @default(RUNNING)
  errorMessage  String?
  startedAt     DateTime       @default(now())
  completedAt   DateTime?

  agentRun      AgentRun?      @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  receipt       Receipt?       @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  @@index([agentRunId])
  @@index([receiptId])
  @@index([toolName])
}

model Approval {
  id          String       @id @default(cuid())
  receiptId   String
  status      ReviewStatus @default(PENDING)
  reason      String
  requestedAt DateTime     @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?
  comment     String?

  receipt     Receipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@index([status])
}

model AuditEvent {
  id          String      @id @default(cuid())
  eventId     String      @unique
  timestamp   DateTime    @default(now())
  actor       String
  receiptId   String?
  agentRunId  String?
  action      String
  inputHash   String?
  resultHash  String?
  ruleVersion String?
  model       String?
  status      AuditStatus
  details     Json?

  receipt     Receipt?    @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  agentRun    AgentRun?   @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@index([receiptId])
  @@index([agentRunId])
  @@index([timestamp])
  @@index([action])
}